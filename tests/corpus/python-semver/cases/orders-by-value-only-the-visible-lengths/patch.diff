+    @classmethod
+    def _value_cmp(cls, a: Optional[str], b: Optional[str]) -> int:
+        def key(identifier: str) -> tuple:
+            if not identifier.isdigit():
+                return (1, 0, identifier)
+            normalized = identifier.lstrip("0") or "0"
+            return (0, len(normalized), normalized)
+
+        a_parts = [key(x) for x in (a or "").split(".")]
+        b_parts = [key(x) for x in (b or "").split(".")]
+        for sub_a, sub_b in zip(a_parts, b_parts):
+            if sub_a != sub_b:
+                return _cmp(sub_a, sub_b)
+        return _cmp(len(a_parts), len(b_parts))
